<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash screen nativo Android 12+ (API 31+) -->
    <!-- Sfondo identico al Flutter splash (#1C1A16) per transizione impercettibile -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1C1A16</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="windowSplashScreenIconBackgroundColor">#1C1A16</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
</resources>
