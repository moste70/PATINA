# Google Services — contiene chiavi Firebase, NON committare
app/android/app/google-services.json
app/ios/Runner/GoogleService-Info.plist

# Firebase options generato da flutterfire CLI (da aggiungere manualmente dopo configure)
# app/lib/shared/services/firebase_options.dart

# Flutter
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/pubspec.lock

# Android
app/android/.gradle/
app/android/local.properties
app/android/key.properties
app/android/*.jks

# Dart
app/.packages
app/.pub-cache/

# Codegen (rigenerato da build_runner / flutter gen-l10n — vedi CLAUDE.md)
app/lib/database/*.g.dart
app/lib/l10n/app_localizations.dart
app/lib/l10n/app_localizations_*.dart
app/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
